{
  "_about": "Per-Drake-build field binding. Copy to binding.json and fill in on the VM. INPUT: each field maps a LOGICAL name (what Fynn sends) to how the agent reaches it — on Drake 2025 automation_id is dead (custom-drawn grid), so navigate by field_no (Drake heads-down field number) or tab_index (Tabs from the screen's first field); the agent tries automation_id, then field_no, then tab_index. READ-BACK: Drake exposes no programmatic value, so verification is either OCR of a screen crop (add \"ocr_box\": [x, y, w, h] in window-relative pixels — capture the window with `agent.py shoot`, read the box off the PNG) or the human screenshot floor.",

  "app_title_re": "Drake \\d{4} Tax Software",
  "main_window_min": [600, 400],
  "_main_window_min_note": "Minimum [width, height] for the window the agent binds to. Drake's Live Chat overlay is a topmost ~84x84 window in the same process; this size floor makes the agent pick the real data-entry frame instead. Confirm with `agent.py probe` / `shoot`, which print the bound window's title + size.",

  "capabilities": {
    "_note": "read_back_method: how the agent reads a box back. On Drake 2025 ALL programmatic reads are dead — UIA (0 values), win32 (0 inner fields), clipboard (copy returns nothing + breaks focus). Options: 'ocr' (screenshot a per-field ocr_box crop and OCR it — approximate, needs pytesseract + Tesseract + calibrated ocr_box; set can_read_field_values=true and expect confidence<1.0), 'screenshot' (no automated value — a human verifies the capture; the honest floor), or 'none' (no verification — Fynn's honesty gate keeps live OFF). 'uia'/'clipboard' are kept for other software / a future build.",
    "read_back_method": "none",
    "can_read_field_values": false,
    "can_observe_element_state": true,
    "can_screenshot": true,
    "can_keyboard_navigate": true
  },

  "navigation": {
    "_note": "Key chords in pywinauto send_keys() syntax. Calibrate against your Drake build.",
    "to_data_entry_selector": "{ESC}",
    "open_screen_suffix": "{ENTER}",
    "headsdown_toggle": "^n",
    "headsdown_jump_suffix": "{ENTER}",
    "new_instance": "{PGDN}",
    "save_and_exit": "{ESC}",
    "field_commit": "{ENTER}",
    "field_clear": "^a{BACKSPACE}"
  },

