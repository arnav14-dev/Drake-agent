# Machine-specific calibration — never commit (it's per Drake build/resolution).
binding.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Local artifacts
*.png
*.log

# Halt diagnostics — rewritten on every halt, and the window topology it captures
# includes the OPEN RETURN'S TITLE (client name + ID). Fine to read locally, never
# in git history. Send it by hand when a halt needs diagnosing.
env-dump-halt.json

# Screen reconnaissance dumps (`agent.py explore --out ...`). Worse than the halt dump:
# they capture the WHOLE client list, and Drake puts each client's FULL UNMASKED SSN in
# the search-result rows' automation ids — the visible cell is masked to 'XXXXX6789', the
# id behind it is not. That property is exactly why navigation can match a client safely,
# and exactly why these files must never reach a repo.
explore*.json

# OS / editor
.DS_Store
Thumbs.db
